#!/usr/bin/env bash
# deploy/update — bringt eine BEREITS konfigurierte term-web-Installation nach
# einem Stand-Update auf aktuell: git pull -> build -> (nur wenn das Backend sich
# geaendert hat) sessions-schonender Restart via deploy/term-restart.
#
# Warum getrennt von install.sh:
#   install.sh ist Installer/Konfigurator: es fragt .env, Service-Namen, Caddy
#   usw. ab und schreibt Unit-Files. Vor allem startet es einen bereits laufenden
#   Dienst NICHT neu — `systemctl enable --now` ist auf einer aktiven Unit ein
#   No-op. Backend-Aenderungen in server.js wuerden nach `git pull && install.sh`
#   also gar nicht aktiv (nur das neu gebaute Frontend, das ein Tab-Reload holt).
#   deploy/update fasst die Konfiguration NICHT an und aktiviert Backend-
#   Aenderungen ueber deploy/term-restart, das laufende Claude-/Kimi-Sessions
#   vorher snapshottet und per `claude --resume` bzw. `kimi --continue`
#   wiederherstellt.
#
# Erstlauf-sicher — Entscheidungen bewusst NICHT aus dem Pull-Diff abgeleitet:
#   Beim ersten Einsatz ging dem Aufruf ein manuelles `git pull` voraus (so kommt
#   dieses Skript ueberhaupt erst auf die Maschine). Das eigene `git pull` findet
#   dann 'Already up to date' — ein leerer Diff heisst hier also NICHT 'nichts zu
#   tun'. Deshalb:
#     * Build laeuft IMMER (esbuild ist billig; public/ spiegelt danach src/).
#     * Restart NUR, wenn eine Backend-Datei (server.js/package*.json) neuer ist
#       als der LAUFENDE Prozess (Datei-mtime vs. ActiveEnterTimestamp des
#       Dienstes). Das vergleicht den Ist-Zustand gegen den echten Prozess und
#       ist damit unabhaengig davon, was der Pull gerade geholt hat.
#
# Servicename: NICHT mehr hart 'term-server', sondern robust ermittelt (explizit
#   $TERM_SERVICE -> deploy/deploy.env -> Auto-Erkennung des laufenden server.js
#   dieses Repos, s. deploy/lib-service.sh). Wird ein Backend-Update erkannt, aber
#   kein passender aktiver Dienst gefunden, bricht das Skript LAUT ab (Exit != 0)
#   statt still nur das Frontend zu bauen.
#
# Standard-Session-Wrapper: Phase 3b stellt sicher, dass die ~/.bashrc
#   deploy/standard-session-wrappers.sh sourct (fehlt auf Instanzen mit altem
#   install.sh-Stand), und laesst untaetige bash-Panes die ~/.bashrc neu
#   einlesen, damit Wrapper-Aenderungen auch offene Shells erreichen.
#
# Aufruf:
#   deploy/update              git pull + build + ggf. Restart
#   deploy/update --no-pull    ohne git pull (man hat selbst schon gepullt)
#   deploy/update --help
#
# Instanz erzwingen:  TERM_SERVICE=<unit> deploy/update   (wird an term-restart
# durchgereicht). Auf Maschinen mit mehreren Instanzen dringend setzen ODER per
# deploy/deploy.env hinterlegen (install.sh legt sie an).
set -euo pipefail

SELF="$(readlink -f "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

log(){ printf '[update] %s\n' "$*" >&2; }
die(){ log "FEHLER: $*"; exit 1; }

# Gemeinsame Servicenamen-Ermittlung (mit deploy/term-restart geteilt).
# shellcheck source=deploy/lib-service.sh
. "$SCRIPT_DIR/deploy/lib-service.sh"

usage(){
  cat >&2 <<USAGE
deploy/update — konfigurierte Installation aktuell halten (kein Re-Setup).

  deploy/update              git pull + build + ggf. sessions-schonender Restart
  deploy/update --no-pull    ohne git pull (man hat selbst schon gepullt)
  deploy/update --help       diese Hilfe

Servicename wird ermittelt: \$TERM_SERVICE -> deploy/deploy.env -> Auto-Erkennung
des laufenden server.js dieses Repos. Erzwingen: TERM_SERVICE=<unit> deploy/update.

Gebaut wird immer; neu gestartet nur, wenn sich das Backend (server.js /
package*.json) gegenueber dem laufenden Prozess geaendert hat. Reine Frontend-
Aenderungen brauchen keinen Restart — im Browser den Tab neu laden. Liegt ein
Backend-Update vor, aber kein passender aktiver Dienst, bricht das Skript ab.
USAGE
}

DO_PULL=1
case "${1:-}" in
  --no-pull)  DO_PULL=0 ;;
  --help|-h)  usage; exit 0 ;;
  '')         ;;
  *)          log "Unbekanntes Argument: $1"; usage; exit 2 ;;
esac

# ---- Phase 1: git pull, dann mit der (evtl. neuen) Version weiter ----------
# `git pull` kann dieses Skript UND deploy/term-restart/lib-service.sh ersetzen.
# Danach die frische Version per exec neu einlesen, bevor build/restart laufen —
# so gilt immer die neueste Logik (auch wenn genau dieses Update sie verbessert
# hat). Der Marker verhindert eine zweite Pull-Runde nach dem Re-exec; ob der
# Pull Backend-Dateien beruehrt hat, wird als Marker ueber den exec gereicht.
if [ "${TERM_UPDATE_REEXEC:-0}" != "1" ] && [ "$DO_PULL" -eq 1 ]; then
  command -v git >/dev/null 2>&1 || die "git nicht gefunden."
  [ -d "$SCRIPT_DIR/.git" ] || die "$SCRIPT_DIR ist kein git-Arbeitsverzeichnis."
  log "git pull in $SCRIPT_DIR …"
  before="$(git -C "$SCRIPT_DIR" rev-parse HEAD)"
  git -C "$SCRIPT_DIR" pull --ff-only \
    || die "git pull (ff-only) fehlgeschlagen — bitte manuell aufloesen (lokale Aenderungen?)."
  after="$(git -C "$SCRIPT_DIR" rev-parse HEAD)"
  if [ "$before" != "$after" ]; then
    log "Aktualisiert: ${before:0:9} -> ${after:0:9}"
    if git -C "$SCRIPT_DIR" diff --name-only "$before" "$after" 2>/dev/null \
         | grep -qE '^(server\.js|package\.json|package-lock\.json)$'; then
      export TERM_UPDATE_PULL_BACKEND=1   # Backend-Datei im Pull geaendert
    fi
  else
    log "git meldet 'up to date' (Pull ohne neue Commits) — es wird trotzdem gebaut."
  fi
  export TERM_UPDATE_REEXEC=1
  exec "$SELF"   # ab hier gilt die frisch gepullte Fassung; Pull wird uebersprungen
fi

# ---- Phase 2: Dienst ermitteln + Restart-Entscheidung (vor jeglichem Build) --
# Reihenfolge ist kritisch: npm install/build unten fassen package-lock.json und
# public/ an und setzen deren mtime auf 'jetzt'. Wuerde die Entscheidung 'ist das
# Backend neuer als der laufende Prozess?' NACH dem Build fallen, loeste der
# eigene Build jedes Mal einen unnoetigen Restart aus (falsch-positiv). Also
# JETZT entscheiden, gegen den unveraenderten Ist-Zustand.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

# setzt SERVICE/SERVICE_SOURCE/REPO_BACKEND_PID/TERM_USER_UNIT; leerer SERVICE = nichts gefunden
term_resolve_service || true
[ -n "$SERVICE" ] && [ "$SERVICE_SOURCE" != "TERM_SERVICE" ] && log "Dienst: $SERVICE (Quelle: $SERVICE_SOURCE)"

# User-Bus proben und noetigenfalls die Umgebung reparieren (s. lib-service.sh).
# Ohne erreichbaren Bus lieferte `systemctl --user` hier bisher "Failed to
# connect ..." und der laufende User-Dienst galt faelschlich als inaktiv.
USER_BUS_OK=1; term_user_bus_repair || USER_BUS_OK=0

# System- vs. User-Unit: aus der Auto-Erkennung (cgroup -> TERM_USER_UNIT) oder,
# bei explizit/deploy.env, per systemctl --user erkennen. Ist der User-Bus nicht
# erreichbar, ersatzweise ueber das Unit-File im User-Verzeichnis.
case "${TERM_USER_UNIT:-}" in
  1|yes|true) USER_UNIT=1 ;;
  0|no|false) USER_UNIT=0 ;;
  *) if [ -n "$SERVICE" ] && [ "$USER_BUS_OK" -eq 1 ] && systemctl --user cat "$SERVICE" >/dev/null 2>&1; then USER_UNIT=1
     elif [ -n "$SERVICE" ] && [ "$USER_BUS_OK" -eq 0 ] && [ -f "$HOME/.config/systemd/user/$SERVICE.service" ]; then USER_UNIT=1
     else USER_UNIT=0; fi ;;
esac
sysctl(){ if [ "$USER_UNIT" -eq 1 ]; then systemctl --user "$@"; else systemctl "$@"; fi; }

# Diese Dateien bestimmen den laufenden Node-Prozess: server.js ist der einzige
# Runtime-Quellcode, package*.json aendern die geladenen Module. Nur bei Aenderung
# an einer davon muss der Prozess neu geladen werden.
BACKEND_FILES="server.js package.json package-lock.json"
PULL_BACKEND="${TERM_UPDATE_PULL_BACKEND:-0}"

# Aktiv-Erkennung. Fallback bei unerreichbarem User-Bus: laeuft der server.js
# dieses Repos nachweislich (Prozess-Evidenz), ist der Dienst offensichtlich
# aktiv — sonst wuerde hier faelschlich "nicht aktiv" gemeldet und ein Backend-
# Update als Exit 3 abgebrochen, obwohl nur der Bus-Zugriff fehlt (21.07.2026).
SERVICE_ACTIVE=0; BUS_FALLBACK=0
if [ -n "$SERVICE" ]; then
  if [ "$USER_UNIT" -eq 1 ] && [ "$USER_BUS_OK" -eq 0 ]; then
    [ -z "${REPO_BACKEND_PID:-}" ] && REPO_BACKEND_PID="$(term_detect_repo_backend_pid || true)"
    if [ -n "$REPO_BACKEND_PID" ] && [ -e "/proc/$REPO_BACKEND_PID" ]; then
      SERVICE_ACTIVE=1; BUS_FALLBACK=1
      log "User-Bus nicht erreichbar — Dienst '$SERVICE' gilt als aktiv (laufender server.js, PID $REPO_BACKEND_PID)."
    fi
  elif sysctl is-active --quiet "$SERVICE"; then
    SERVICE_ACTIVE=1
  fi
fi

# NEED_RESTART strikt aus dem Ist-Zustand (mtime vs. ActiveEnterTimestamp) —
# diese Heuristik bleibt unveraendert. Nur mit aktivem Dienst auswertbar.
# Im Bus-Fallback ersetzt die Startzeit des Prozesses (/proc-mtime) den nicht
# abfragbaren ActiveEnterTimestamp.
NEED_RESTART=0
if [ "$SERVICE_ACTIVE" -eq 1 ]; then
  if [ "$BUS_FALLBACK" -eq 1 ]; then
    started_epoch="$(stat -c %Y "/proc/$REPO_BACKEND_PID" 2>/dev/null || echo 0)"
  else
    started="$(sysctl show -p ActiveEnterTimestamp --value "$SERVICE" 2>/dev/null || true)"
    started_epoch=0
    [ -n "$started" ] && started_epoch="$(date -d "$started" +%s 2>/dev/null || echo 0)"
  fi
  if [ "$started_epoch" -le 0 ]; then
    log "Startzeit des Dienstes nicht ermittelbar — sicherheitshalber Restart nach dem Build."
    NEED_RESTART=1
  else
    for f in $BACKEND_FILES; do
      fp="$SCRIPT_DIR/$f"
      [ -f "$fp" ] || continue
      mt="$(stat -c %Y "$fp" 2>/dev/null || echo 0)"
      if [ "$mt" -gt "$started_epoch" ]; then
        log "Backend geaendert: $f ist neuer als der laufende Prozess."
        NEED_RESTART=1
      fi
    done
  fi
  [ "$NEED_RESTART" -eq 0 ] && log "Backend unveraendert gegenueber dem laufenden Prozess — kein Restart noetig."
fi

# Ohne aktiven Dienst: liegt trotzdem ein Backend-Update an, das sonst STILL
# liegenbliebe (genau der Vorfall)? Signale ohne ActiveEnterTimestamp:
#   (i) ein erkannter, aber nicht neustartbarer server.js-Prozess (proc-no-unit),
#       dessen Start aelter als eine Backend-Datei ist;
#   (ii) der git pull dieses Laufs hat Backend-Dateien geaendert.
BACKEND_PENDING=0
if [ "$SERVICE_ACTIVE" -eq 0 ]; then
  if [ -n "${REPO_BACKEND_PID:-}" ] && [ -e "/proc/${REPO_BACKEND_PID}" ]; then
    ps_start="$(stat -c %Y "/proc/${REPO_BACKEND_PID}" 2>/dev/null || echo 0)"
    for f in $BACKEND_FILES; do
      fp="$SCRIPT_DIR/$f"
      [ -f "$fp" ] || continue
      mt="$(stat -c %Y "$fp" 2>/dev/null || echo 0)"
      [ "$mt" -gt "$ps_start" ] && BACKEND_PENDING=1
    done
  fi
  [ "$PULL_BACKEND" -eq 1 ] && BACKEND_PENDING=1
fi

# ---- Phase 3: bauen (immer) ------------------------------------------------
# node/npm-Suche wie install.sh: projekt-lokales vendor/node hat Vorrang (manche
# Maschinen halten node bewusst aus dem PATH). Fuer vendor/node muss npm-Config/
# -Cache ins Projekt umgeleitet werden (ein ~/.npmrc stoert ein bun-Nachbarprojekt).
find_cmd(){
  local name="$1" p latest
  if [ -x "$SCRIPT_DIR/vendor/node/bin/$name" ]; then printf '%s' "$SCRIPT_DIR/vendor/node/bin/$name"; return 0; fi
  if p="$(command -v "$name" 2>/dev/null)"; then printf '%s' "$p"; return 0; fi
  for p in "$HOME/.local/bin/$name" "$HOME/.volta/bin/$name" \
           "/usr/local/bin/$name" "/usr/bin/$name" "/opt/homebrew/bin/$name"; do
    [ -x "$p" ] && { printf '%s' "$p"; return 0; }
  done
  if [ -d "$HOME/.nvm/versions/node" ]; then
    latest="$(ls -1 "$HOME/.nvm/versions/node" 2>/dev/null | sort -V | tail -n1)"
    if [ -n "$latest" ] && [ -x "$HOME/.nvm/versions/node/$latest/bin/$name" ]; then
      printf '%s' "$HOME/.nvm/versions/node/$latest/bin/$name"; return 0
    fi
  fi
  return 1
}

NPM_BIN="$(find_cmd npm || true)";  [ -n "$NPM_BIN" ]  || die "npm nicht gefunden (PATH/vendor/node/nvm geprueft)."
NODE_BIN="$(find_cmd node || true)"
USING_VENDOR_NODE=0
case "$NODE_BIN" in "$SCRIPT_DIR/vendor/node/bin/"*) USING_VENDOR_NODE=1 ;; esac
NODE_DIR=""; [ -n "$NODE_BIN" ] && NODE_DIR="$(dirname "$NODE_BIN")"

run_npm(){
  if [ "$USING_VENDOR_NODE" -eq 1 ]; then
    ( cd "$SCRIPT_DIR" \
      && PATH="${NODE_DIR:+$NODE_DIR:}$PATH" \
         NPM_CONFIG_USERCONFIG="$SCRIPT_DIR/.npmrc" \
         NPM_CONFIG_CACHE="$SCRIPT_DIR/.npm-cache" \
         "$NPM_BIN" "$@" )
  else
    ( cd "$SCRIPT_DIR" && PATH="${NODE_DIR:+$NODE_DIR:}$PATH" "$NPM_BIN" "$@" )
  fi
}

# ---------------------------------------------------------------------------
# GitHub-Transport fuer die mdlite-git-Dependency mit sicherer Fallback-Kette:
#   1. git  (ssh-Key vorhanden)          -> nativer git+ssh-Clone (Standard)
#   2. gh   (authentifiziertes gh-CLI)   -> git ueber gh-HTTPS, scoped Config
# package.json/-lock pinnen einen unveraenderlichen Commit. Einen frueheren
# Tarball-Fallback gibt es bewusst nicht mehr: GitHub-Tarballs zu beweglichen
# Tags wurden ohne Inhalts-Hash installiert und unterliefen damit das Lockfile.
# Hintergrund: npm normalisiert die github-git-Dependency im Lockfile IMMER auf
# git+ssh; Server ohne GitHub-SSH-Key wuerden am Clone scheitern. Diese Kette
# faengt das ab, ohne die Reproduzierbarkeit der committeten Dateien aufzugeben.
MDLITE_REPO_SSH="git@github.com:Etschmia/mdlite.git"
DEPLOY_GITCFG="$SCRIPT_DIR/.deploy-gitconfig"   # scoped, faerbt ~/.gitconfig nicht ein

# npm install mit der Transport-Kette git -> gh; beide beziehen exakt den Commit.
install_deps_resilient(){
  # 1. git (ssh): Clone-Faehigkeit billig proben (BatchMode: kein Passwort-Prompt).
  if GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=6' \
       git ls-remote "$MDLITE_REPO_SSH" >/dev/null 2>&1; then
    log "mdlite-Transport: git (ssh)."
    run_npm install && return 0
    log "mdlite: git-Install fehlgeschlagen -> naechste Methode."
  fi
  # 2. gh: authentifiziertes gh-CLI -> git ueber HTTPS mit gh-Token (scoped Config,
  #    faerbt die globale git-Config nicht ein). insteadOf leitet die im Lockfile
  #    gepinnte ssh-URL auf HTTPS um.
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    log "mdlite-Transport: gh (HTTPS)."
    cat > "$DEPLOY_GITCFG" <<'GITCFG'
[url "https://github.com/"]
insteadOf = ssh://git@github.com/
insteadOf = git@github.com:
[credential]
helper = !gh auth git-credential
GITCFG
    local rc=0
    export GIT_CONFIG_GLOBAL="$DEPLOY_GITCFG"
    run_npm install || rc=$?
    unset GIT_CONFIG_GLOBAL
    rm -f "$DEPLOY_GITCFG"
    [ "$rc" -eq 0 ] && return 0
    log "mdlite: gh-Install fehlgeschlagen."
  fi
  die "mdlite konnte weder per git/SSH noch per authentifiziertem gh/HTTPS installiert werden. Kein ungepruefter Tarball-Fallback."
}

# Abhaengigkeiten nur bei ECHTER Aenderung installieren — anhand eines Inhalts-
# Hashes von package-lock.json, gemerkt nach dem letzten erfolgreichen install.
# Warum kein mtime- oder cmp-Vergleich:
#   * git setzt beim Checkout die mtime von package-lock.json neu, ohne Inhalts-
#     aenderung -> ein '-nt'-Test liefe bei jedem Aufruf.
#   * npm install schreibt package-lock.json (mtime) auch dann neu, wenn nichts
#     zu tun war -> das wuerde ausserdem die Restart-Heuristik (Phase 2) ueber
#     mehrere Laeufe hinweg faelschlich triggern.
#   * node_modules/.package-lock.json hat ein anderes Format als package-lock.json,
#     ein cmp meldet also staendig 'unterschiedlich'.
# Der Hash-Stamp ist gegen all das robust: nur eine echte Lockfile-Aenderung
# (also eine echte Abhaengigkeits-Aenderung) loest install aus.
lock_hash(){ sha256sum "$SCRIPT_DIR/package-lock.json" 2>/dev/null | awk '{print $1}'; }
LOCK="$SCRIPT_DIR/package-lock.json"
DEPS_STAMP="$SCRIPT_DIR/node_modules/.term-deps-stamp"
want_hash="$(lock_hash)"
have_hash=""; [ -f "$DEPS_STAMP" ] && have_hash="$(cat "$DEPS_STAMP" 2>/dev/null || true)"
if [ ! -d "$SCRIPT_DIR/node_modules" ] || [ -z "$want_hash" ] || [ "$want_hash" != "$have_hash" ]; then
  log "Abhaengigkeiten aktualisieren (npm install) …"
  lock_mtime_before="$(stat -c %Y "$LOCK" 2>/dev/null || echo 0)"
  install_deps_resilient   # git -> gh; beide folgen dem gepinnten Commit
  after_hash="$(lock_hash)"
  if [ "$after_hash" = "$want_hash" ] && [ "$lock_mtime_before" -gt 0 ]; then
    # npm hat package-lock.json nur die mtime verpasst (Inhalt gleich). Original-
    # mtime wiederherstellen, sonst haelt Phase 2 im NAECHSTEN Lauf das Lockfile
    # faelschlich fuer 'neuer als der Prozess' und startet unnoetig neu.
    touch -d "@$lock_mtime_before" "$LOCK" 2>/dev/null || true
  elif [ "$after_hash" != "$want_hash" ]; then
    # npm hat echte Aenderungen aufgeloest -> Prozess muss die neuen Module laden.
    log "Abhaengigkeiten haben sich geaendert -> Restart faellig."
    NEED_RESTART=1; BACKEND_PENDING=1
  fi
  printf '%s\n' "$after_hash" > "$DEPS_STAMP" 2>/dev/null || true
else
  log "Abhaengigkeiten unveraendert — npm install uebersprungen."
fi

log "Frontend bauen (npm run build) …"
run_npm run build || die "Build fehlgeschlagen."
log "Build ok -> public/"

# ---- Phase 3b: Standard-Session-Wrapper (bashrc) ---------------------------
# deploy/standard-session-wrappers.sh (claude/codex/grok/kimi aus der Standard-
# Sitzung in eigene tmux-Sessions umlenken) wird aus der ~/.bashrc gesourct.
# Zwei Dinge erledigt ein reines git pull NICHT:
#   * Instanzen, deren install.sh-Lauf aelter ist als das Feature, haben die
#     Source-Zeile gar nicht -> hier nachtragen (gleicher Block wie install.sh).
#   * Bereits laufende Shells (v. a. die persistente Standard-Sitzung) behalten
#     die alten Funktionen -> untaetige bash-Panes lesen die ~/.bashrc per
#     send-keys neu ein; belegte Panes (laufendes claude/vim/...) werden nur
#     gemeldet, dort muss man nach Ende selbst '. ~/.bashrc' ausfuehren.
# Muss VOR Phase 4 laufen: term-restart kann die eigene Sitzung beenden.
WRAP_SRC="$SCRIPT_DIR/deploy/standard-session-wrappers.sh"
BASHRC="$HOME/.bashrc"
if [ -f "$WRAP_SRC" ] && ! grep -qF "standard-session-wrappers.sh" "$BASHRC" 2>/dev/null; then
  printf '\n# term-web: claude/codex/grok/kimi aus der Standard-Sitzung in eigene tmux-Sessions\n[ -f "%s" ] && . "%s"\n' \
    "$WRAP_SRC" "$WRAP_SRC" >> "$BASHRC"
  log "Standard-Session-Wrapper in ~/.bashrc eingebunden (Zeile fehlte noch)."
fi
if command -v tmux >/dev/null 2>&1 && tmux list-panes -a >/dev/null 2>&1; then
  RELOADED=0; BUSY=""
  while IFS="$(printf '\t')" read -r pane sess cmd inmode; do
    if [ "$cmd" = "bash" ] && [ "$inmode" = "0" ]; then
      # C-u raeumt eine evtl. halb getippte Zeile weg (per C-y wiederholbar);
      # fuehrendes Leerzeichen haelt den Befehl bei ignorespace aus der History.
      if tmux send-keys -t "$pane" C-u " . ~/.bashrc" Enter 2>/dev/null; then
        RELOADED=$((RELOADED+1))
      fi
    else
      BUSY="$BUSY $sess($cmd)"
    fi
  done < <(tmux list-panes -a -F '#{pane_id}	#{session_name}	#{pane_current_command}	#{pane_in_mode}' 2>/dev/null)
  [ "$RELOADED" -gt 0 ] && log "~/.bashrc in $RELOADED bash-Pane(s) neu eingelesen — Session-Wrapper dort aktuell."
  [ -n "$BUSY" ] && log "Pane(s) beschaeftigt, nicht neu eingelesen:$BUSY — dort spaeter '. ~/.bashrc' ausfuehren."
fi

# ---- Phase 4: handeln ------------------------------------------------------
if [ "$SERVICE_ACTIVE" -eq 1 ]; then
  if [ "$NEED_RESTART" -eq 1 ] && [ "$BUS_FALLBACK" -eq 1 ]; then
    # Restart faellig, aber ohne User-Bus nicht ausfuehrbar (auch term-restart/
    # systemd-run --user brauchen ihn). Lauter, ZUTREFFENDER Fehler statt des
    # irrefuehrenden "Dienst ist nicht aktiv" von frueher.
    log ""
    log "################################  FEHLER  ################################"
    log "Backend-Update faellig, Dienst '$SERVICE' laeuft (PID ${REPO_BACKEND_PID:-?}) —"
    log "aber systemctl --user erreicht den User-Bus nicht (auch nach Reparatur von"
    log "XDG_RUNTIME_DIR). Aus dieser Sitzung ist KEIN Restart moeglich; das neue"
    log "server.js ist gebaut, aber noch nicht aktiv."
    log "Abhilfe: aus einer echten Login-Sitzung (z. B. SSH) als $(id -un) ausfuehren:"
    log "    TERM_SERVICE=$SERVICE deploy/update --no-pull"
    log "Bleibt der Bus auch dort unerreichbar: 'loginctl enable-linger $(id -un)'"
    log "(haelt den systemd-User-Manager dauerhaft am Leben)."
    log "#########################################################################"
    exit 4
  elif [ "$NEED_RESTART" -eq 1 ]; then
    log "-> sessions-schonender Restart via deploy/term-restart (Claude-/Kimi-Sessions kommen per --resume/--continue zurueck) …"
    TERM_SERVICE="$SERVICE" TERM_USER_UNIT="$USER_UNIT" "$SCRIPT_DIR/deploy/term-restart"
    # term-restart beendet diese Sitzung ggf. selbst; danach resumt sie automatisch.
  else
    log "Fertig. Falls sich das Frontend geaendert hat: im Browser den Tab neu laden."
  fi
elif [ "$BACKEND_PENDING" -eq 1 ]; then
  # Lauter Fehlschlag statt beruhigendem Weiterlaufen — genau der Vorfall, den
  # wir verhindern wollen (neues Frontend, altes/kein Backend, keine Meldung).
  log ""
  log "################################  FEHLER  ################################"
  log "Ein Backend-Update liegt vor, aber es wurde KEIN passender aktiver"
  log "term-web-Dienst gefunden — das neue server.js wird NICHT aktiv, und das"
  log "frisch gebaute Frontend liefe gegen ein veraltetes/fehlendes Backend."
  case "${SERVICE_SOURCE:-none}" in
    auto:proc-no-unit)
      log "Grund: ein laufender server.js dieses Repos (PID ${REPO_BACKEND_PID:-?}) liess"
      log "sich keiner systemd-Unit zuordnen." ;;
    none)
      log "Grund: kein laufender server.js dieses Repos und kein Servicename hinterlegt." ;;
    *)
      log "Grund: Dienst '$SERVICE' (Quelle: ${SERVICE_SOURCE:-?}) ist nicht aktiv." ;;
  esac
  log "Abhilfe: richtige Instanz benennen und erneut ausfuehren, z. B."
  log "    TERM_SERVICE=<unit> deploy/update --no-pull"
  log "oder deploy/deploy.env mit 'TERM_SERVICE=<unit>' anlegen (install.sh tut das)."
  log "Laufende Units listen:  systemctl list-units --type=service | grep -i term"
  log "#########################################################################"
  exit 3
else
  log "Fertig. Kein aktiver Dienst gefunden, aber auch kein anhaengiges Backend-Update."
  log "Falls sich das Frontend geaendert hat: im Browser den Tab neu laden."
fi
