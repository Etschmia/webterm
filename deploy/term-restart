#!/usr/bin/env bash
# term-restart — startet term-server.service neu, OHNE laufende Claude-Sessions zu verlieren.
#
# Hintergrund: Das Webterminal (server.js) hostet ALLE tmux-Sessions im cgroup von
# term-server.service. Ein einfaches `systemctl restart term-server` reißt wegen
# KillMode=control-group das gesamte cgroup ab — also den tmux-Server samt jeder
# darin laufenden Claude-Sitzung (auch fremder!). Genau das ist am 24.06.2026 passiert.
#
# Dieser Wrapper:
#   1. snapshottet alle tmux-Panes, die gerade `claude` laufen (Session-Name + cwd),
#   2. führt den Restart aus einer ENTKOPPELTEN transienten systemd-Unit aus, die den
#      cgroup-Abriss überlebt (KillMode=none, eigenes cgroup unter system.slice),
#   3. setzt nach dem Restart jede Sitzung per `claude --resume <neueste-session-id>`
#      wieder auf — die Konversationen kommen also mit voller Historie zurück.
#
# Benutze IMMER diesen Befehl statt `systemctl restart term-server`, wenn du aus einer
# Sitzung heraus neu startest, die selbst im Webterminal läuft.
#
# Aufruf:  deploy/term-restart           (normaler entkoppelter Restart + Restore)
#          deploy/term-restart --restore <snapfile>   (intern, von der Unit aufgerufen)
#
# Der Service kann als System-Unit (/etc/systemd/system, Restart braucht sudo) ODER als
# User-Unit (~/.config/systemd/user, komplett ohne sudo) laufen. Das Skript erkennt
# automatisch, wo die Unit liegt; Override per TERM_USER_UNIT=1 bzw. =0.
set -euo pipefail

PROJECTS="$HOME/.claude/projects"

log(){ printf '[term-restart] %s\n' "$*" >&2; }

# Servicenamen robust ermitteln: explizit $TERM_SERVICE -> deploy/deploy.env ->
# Auto-Erkennung des laufenden server.js dieses Repos (frueher hart 'term-server' —
# das traf auf abweichend benannten Instanzen die falsche bzw. keine Unit).
# term_resolve_service setzt SERVICE/SERVICE_SOURCE/REPO_BACKEND_PID und ggf.
# TERM_USER_UNIT. Nicht-Null-Rueckgabe (kein Dienst gefunden) hier tolerieren —
# der Normalpfad prueft SERVICE unten explizit; --help soll ohne Dienst laufen.
# shellcheck source=deploy/lib-service.sh
. "$(dirname "$(readlink -f "$0")")/lib-service.sh"
term_resolve_service || true

# PTY-Umgebungen (z. B. das Webterminal selbst) setzen XDG_RUNTIME_DIR oft nicht —
# ohne das erreicht `systemctl --user` den User-Manager nicht, und die Auto-Erkennung
# unten fiele faelschlich auf die System-Unit zurueck.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

# System- oder User-Unit? Auto-Erkennung: liegt die Unit im User-Manager, wird sie dort
# verwaltet (kein sudo noetig — wichtig fuer Nutzer, die keins haben sollen).
# Die Restore-Phase laeuft in der transienten Unit; dorthin wird das Ergebnis per
# --setenv=TERM_USER_UNIT weitergereicht, damit beide Phasen sicher dasselbe tun.
case "${TERM_USER_UNIT:-}" in
  1|yes|true)  USER_UNIT=1 ;;
  0|no|false)  USER_UNIT=0 ;;
  *) if systemctl --user cat "$SERVICE" >/dev/null 2>&1; then USER_UNIT=1; else USER_UNIT=0; fi ;;
esac

sysctl(){
  if [ "$USER_UNIT" -eq 1 ]; then systemctl --user "$@"; else systemctl "$@"; fi
}

# cwd -> Name des Claude-Projektverzeichnisses (Claude ersetzt '/' und '.' durch '-').
enc_dir(){ printf '%s' "$1" | sed 's#[/.]#-#g'; }

# bin-Verzeichnis der aktiven node-Installation (fuer den PATH der Unit, s.u.).
# Suchreihenfolge wie install.sh: PATH, projekt-lokales vendor/node, gaengige Orte,
# dann neueste nvm-Version.
node_bin_dir(){
  local p latest
  if p="$(command -v node 2>/dev/null)"; then dirname "$p"; return 0; fi
  # Deployments ohne globales node (z. B. neben einem bun-Projekt) halten node
  # projekt-lokal in vendor/node und bewusst aus dem PATH heraus.
  p="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/vendor/node/bin/node"
  [ -x "$p" ] && { dirname "$p"; return 0; }
  for p in "$HOME/.local/bin/node" "$HOME/.volta/bin/node" /usr/local/bin/node \
           /usr/bin/node /opt/homebrew/bin/node; do
    [ -x "$p" ] && { dirname "$p"; return 0; }
  done
  if [ -d "$HOME/.nvm/versions/node" ]; then
    latest="$(ls -1 "$HOME/.nvm/versions/node" 2>/dev/null | sort -V | tail -n1)"
    if [ -n "$latest" ] && [ -x "$HOME/.nvm/versions/node/$latest/bin/node" ]; then
      printf '%s\n' "$HOME/.nvm/versions/node/$latest/bin"; return 0
    fi
  fi
  return 1
}

# Neueste Top-Level-Session-ID (*.jsonl) für ein cwd, ohne subagents/.
newest_session_id(){
  local dir="$PROJECTS/$(enc_dir "$1")" f
  [ -d "$dir" ] || return 1
  f=$(find "$dir" -maxdepth 1 -name '*.jsonl' -printf '%T@ %f\n' 2>/dev/null \
        | sort -rn | head -1 | awk '{print $2}')
  [ -n "$f" ] && printf '%s' "${f%.jsonl}"
}

# name<TAB>cwd je tmux-Pane, in dessen Prozess-Subtree ein `claude` läuft.
# (Robust gegen den claude-auto-retry-Wrapper: dort meldet pane_current_command
#  'bash'/'node'; verlässlich ist nur der Prozessname comm=claude irgendwo im Baum.)
snapshot(){
  local panes
  panes=$(tmux list-panes -a -F '#{pane_pid}|#{session_name}|#{pane_current_path}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0
  ps -e -o pid=,ppid=,comm= | awk -v panes="$panes" '
    BEGIN{
      n=split(panes, rows, "\n");
      for(i=1;i<=n;i++){ if(rows[i]=="") continue; split(rows[i], a, "|"); paneinfo[a[1]]=a[2]"\t"a[3] }
    }
    { ppid[$1]=$2; comm[$1]=$3 }
    END{
      for(pid in comm){
        if(comm[pid]!="claude") continue
        x=pid
        while(x!="" && x!=0 && (x in ppid)){
          if(x in paneinfo){ found[x]=1; break }
          x=ppid[x]
        }
      }
      for(p in found) print paneinfo[p]
    }' | sort -u
}

# Phase 2 (in der entkoppelten Unit): warten bis Service zurück ist, dann Sessions resumen.
restore(){
  local snapfile="$1" name cwd sid i
  for i in $(seq 1 60); do
    sysctl is-active --quiet "$SERVICE" && break
    sleep 0.5
  done
  while IFS=$'\t' read -r name cwd; do
    [ -n "${name:-}" ] || continue
    if tmux has-session -t "$name" 2>/dev/null; then
      log "Session '$name' existiert bereits — übersprungen."
      continue
    fi
    tmux new-session -d -s "$name" -c "$cwd"
    if sid=$(newest_session_id "$cwd"); then
      log "Restore '$name' ($cwd) -> claude --resume $sid"
      tmux send-keys -t "$name" "claude --resume $sid" Enter
    else
      log "Kein Transkript für $cwd — leere Session '$name' angelegt."
    fi
  done < "$snapfile"
  rm -f "$snapfile"
  log "Restore abgeschlossen."
}

usage(){
  cat >&2 <<USAGE
term-restart — Restart von '$SERVICE' ohne Verlust laufender Claude-Sessions.

  deploy/term-restart                       entkoppelter Restart + Restore
  deploy/term-restart --restore <snapfile>  intern, von der Unit aufgerufen
  deploy/term-restart --help                diese Hilfe

Service via TERM_SERVICE waehlen (Default: term-server). Auf Maschinen mit
mehreren Instanzen ZWINGEND setzen, sonst trifft es die fremde Instanz:
  TERM_SERVICE=tbterm deploy/term-restart

System- vs. User-Unit wird automatisch erkannt (User-Unit => kein sudo noetig).
Override: TERM_USER_UNIT=1 (User-Unit) bzw. TERM_USER_UNIT=0 (System-Unit).
USAGE
}

# Unbekannte Argumente MUESSEN abbrechen: ohne diesen Zweig fiel z. B. ein
# harmlos gemeintes '--help' in den Normalpfad und hat produktiv durchgestartet
# (am 17.07.2026 so passiert — traf die fremde Instanz 'term-server').
case "${1:-}" in
  --restore)  shift; restore "${1:?snapfile fehlt}"; exit 0 ;;
  --help|-h)  usage; exit 0 ;;
  '')         ;;
  *)          log "Unbekanntes Argument: $1"; usage; exit 2 ;;
esac

# ---- Phase 1: Snapshot, dann Übergabe an entkoppelte Unit ----
# Ab hier der Normalpfad: ohne ermittelten Dienstnamen kein Restart moeglich.
if [ -z "${SERVICE:-}" ]; then
  log "Kein term-web-Dienst gefunden — weder \$TERM_SERVICE noch deploy/deploy.env,"
  log "noch ein laufender server.js dieses Repos (${TERM_REPO_DIR:-?})."
  log "Instanz explizit angeben:  TERM_SERVICE=<unit> $0"
  exit 1
fi
[ "${SERVICE_SOURCE:-}" = "TERM_SERVICE" ] || log "Dienst: $SERVICE (Quelle: ${SERVICE_SOURCE:-?})"
command -v tmux   >/dev/null || { log "tmux nicht gefunden."; exit 1; }
if [ "$USER_UNIT" -eq 0 ]; then
  command -v sudo >/dev/null || { log "sudo nicht gefunden (System-Unit braucht sudo — oder Service als User-Unit betreiben, siehe --help)."; exit 1; }
fi

SNAP=$(mktemp /tmp/term-restart.XXXXXX)
snapshot > "$SNAP"
log "$(wc -l < "$SNAP") aktive Claude-Session(s) gesichert."

SELF=$(readlink -f "$0")
UNIT="term-restart-$$-$(id -u)"
# Robuster PATH für die Unit (claude/node/tmux/systemctl/sudo erreichbar).
# node zur Laufzeit suchen: ein hartkodierter nvm-Pfad zeigt nach jedem Node-Update
# ins Leere, und der Restore-Teil findet dann weder 'node' noch 'claude'.
NODE_DIR="$(node_bin_dir || true)"
[ -n "$NODE_DIR" ] || log "WARNUNG: kein node gefunden — 'claude --resume' schlaegt evtl. fehl."
RUN_PATH="$HOME/.local/bin${NODE_DIR:+:$NODE_DIR}:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

log "Starte entkoppelten Restart in Unit '$UNIT' …"
if [ "$USER_UNIT" -eq 1 ]; then
  # User-Modus: transiente Unit im User-Manager — eigener cgroup neben der Service-Unit,
  # ueberlebt deren Abriss genauso; kein sudo an keiner Stelle.
  systemd-run --user --collect --quiet --unit="$UNIT" \
    -p KillMode=none \
    --setenv=HOME="$HOME" \
    --setenv=PATH="$RUN_PATH" \
    --setenv=LANG="${LANG:-C.UTF-8}" \
    --setenv=LC_ALL="${LC_ALL:-${LANG:-C.UTF-8}}" \
    --setenv=XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    --setenv=TERM_SERVICE="$SERVICE" \
    --setenv=TERM_USER_UNIT=1 \
    bash -c "systemctl --user restart '$SERVICE'; '$SELF' --restore '$SNAP'"
else
  sudo systemd-run --collect --quiet --unit="$UNIT" \
    --uid="$(id -u)" --gid="$(id -g)" \
    -p KillMode=none \
    --setenv=HOME="$HOME" \
    --setenv=PATH="$RUN_PATH" \
    --setenv=LANG="${LANG:-C.UTF-8}" \
    --setenv=LC_ALL="${LC_ALL:-${LANG:-C.UTF-8}}" \
    --setenv=TERM_SERVICE="$SERVICE" \
    --setenv=TERM_USER_UNIT=0 \
    bash -c "sudo -n systemctl restart '$SERVICE'; '$SELF' --restore '$SNAP'"
fi

log "Restart entkoppelt angestoßen. Diese Sitzung wird gleich beendet —"
log "die Claude-Sessions kommen automatisch per 'claude --resume' zurück."
