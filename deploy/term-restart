#!/usr/bin/env bash
# Restart nur, wenn keine tmux-Sitzung in der Ziel-cgroup gefaehrdet ist.
# Gilt fuer alle Tools, Shells, Fenster und Panes; kein unvollstaendiges Resume.
set -euo pipefail
log(){ printf '[term-restart] %s\n' "$*" >&2; }
SELF="$(readlink -f "$0")"
RESTART_DIR="$(dirname "$SELF")"
case "${1:-}" in
  --help|-h)
    printf '%s\n' 'deploy/term-restart [--check]' \
      'Dienst: TERM_SERVICE -> deploy/deploy.env -> Prozess-Erkennung.' \
      '--check prueft ohne Restart. Exit 5: tmux gefaehrdet oder Pruefung unvollstaendig.'
    exit 0 ;;
  ''|--check|--execute) ;;
  *) log "Unbekanntes Argument: $1"; exit 2 ;;
esac
. "$RESTART_DIR/lib-service.sh"
term_resolve_service || true
[[ "${SERVICE:-}" =~ ^[A-Za-z0-9_@.:-]+$ ]] || { log 'Kein gueltiger Dienst ermittelt; TERM_SERVICE setzen.'; exit 1; }
USER_BUS_OK=1; term_user_bus_repair || USER_BUS_OK=0
case "${TERM_USER_UNIT:-}" in
  1|yes|true) USER_UNIT=1 ;;
  0|no|false) USER_UNIT=0 ;;
  *) if [ "$USER_BUS_OK" -eq 1 ] && systemctl --user cat "$SERVICE" >/dev/null 2>&1; then USER_UNIT=1
     elif [ -f "$HOME/.config/systemd/user/$SERVICE.service" ]; then USER_UNIT=1
     else USER_UNIT=0; fi ;;
esac
if [ "$USER_UNIT" -eq 1 ] && [ "$USER_BUS_OK" -eq 0 ]; then
  log 'User-Bus nicht erreichbar; aus einer Login-Sitzung erneut versuchen.'; exit 4
fi
sysctl(){ if [ "$USER_UNIT" -eq 1 ]; then systemctl --user "$@"; else systemctl "$@"; fi; }
NODE_BIN=""
for candidate in "$RESTART_DIR/../vendor/node/bin/node" "$(command -v node || true)" "$HOME/.local/bin/node" /usr/local/bin/node /usr/bin/node; do
  if [ -x "$candidate" ]; then NODE_BIN="$candidate"; break; fi
done
[ -n "$NODE_BIN" ] || { log 'node fuer die Restart-Pruefung nicht gefunden.'; exit 1; }
GROUP="$(sysctl show -p ControlGroup --value "$SERVICE")"
"$NODE_BIN" "$RESTART_DIR/restart-check.mjs" "$GROUP"
[ "${1:-}" != '--check' ] || exit 0
# Auch die entkoppelte Phase prueft erneut direkt vor dem Restart.
if [ "${1:-}" = '--execute' ]; then
  if [ "$USER_UNIT" -eq 1 ]; then systemctl --user restart "$SERVICE"
  else sudo -n systemctl restart "$SERVICE"; fi
  sysctl is-active --quiet "$SERVICE"
  log 'Dienst erfolgreich neu gestartet; tmux-Sitzungen bleiben erhalten.'
  exit 0
fi
UNIT="term-restart-$$-$(id -u)"
RUN_PATH="$(dirname "$NODE_BIN"):$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ARGS=(--collect --quiet --unit="$UNIT" -p KillMode=none
  --setenv="HOME=$HOME" --setenv="PATH=$RUN_PATH"
  --setenv="TERM_SERVICE=$SERVICE" --setenv="TERM_USER_UNIT=$USER_UNIT")
if [ "$USER_UNIT" -eq 1 ]; then
  systemd-run --user "${ARGS[@]}" --setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" "$SELF" --execute
else
  sudo -n systemd-run "${ARGS[@]}" --uid="$(id -u)" --gid="$(id -g)" "$SELF" --execute
fi
log "Gepruefter Restart in $UNIT angestossen."
