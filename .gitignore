# Von install.sh erzeugt (lokale Konfiguration / echte Zugangsdaten)
.env
deploy/*.local.*
# Install-lokaler Servicename fuer deploy/update + deploy/term-restart (TERM_SERVICE=…)
deploy/deploy.env

# Lokale Notizen/Ideen — nicht ins Repo (u. a. Betriebsdetails, Publish-Checks)
docs/

# Projekt-lokale node-Installation (vendor/node) samt gekapselter npm-Konfiguration.
# Bewusst NICHT im PATH: nebenan liegt ein bun-Projekt, das ein globales node/npm
# bzw. ein ~/.npmrc stoeren wuerde. Immer ueber absolute Pfade ansprechen.
vendor/
.npm-cache/
.npmrc

# Transiente Dateien des mdlite-Transport-Fallbacks in deploy/update
# (scoped git-Config + Manifest-Backups; werden im Normallauf wieder entfernt).
.deploy-gitconfig
*.deploybak

# Reste von bun-Laeufen — Runtime ist bewusst node (siehe CLAUDE.md)
bun.lock
